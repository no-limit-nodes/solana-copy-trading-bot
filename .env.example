# NoLimitNodes API key for the decoded event streams: https://app.nolimitnodes.com/register
NLN_API_KEY=sk_live_your_key
# NLN_STREAM_ENDPOINT=stream-1.nln.clr3.org:443

# Wallets to copy: comma-separated ADDRESS or ADDRESS:label, and/or a file of "ADDRESS [label]" lines
COPY_WALLETS=
COPY_WALLETS_FILE=
VENUES=pumpfun,pumpswap,raydium_amm_v4,raydium_cpmm,raydium_clmm,orca_whirlpool,meteora_dlmm,meteora_damm

# Live trading only (python run_copytrader.py --live)
NLN_RPC_URL=https://your-nln-rpc-endpoint
# Use a dedicated hot wallet. Set one of these:
SOLANA_KEYPAIR_PATH=
SOLANA_PRIVATE_KEY=
# Optional: Jupiter API key for higher rate limits (https://developers.jup.ag/portal)
JUPITER_API_KEY=

# Sizing and filters
BUY_SOL=0.05
COPY_RATIO=0
MIN_BUY_SOL=0.01
MAX_BUY_SOL=0.5
MIN_TARGET_SOL=0.1
MAX_SIGNAL_AGE_S=20
BLOCKED_MINTS=

# Risk and exits
MAX_POSITIONS=5
STOP_LOSS_PCT=50
TAKE_PROFIT_PCT=0
MAX_HOLD_S=0
MAX_DAILY_LOSS_SOL=1.0
SLIPPAGE_BPS=1000
PRIORITY=high
PAPER_COST_BPS=150

# Telegram alerts (python run_copytrader.py --telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
